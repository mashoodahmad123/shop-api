              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "products",
                "{{product_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1399.0,\n  \"stock_quantity\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Soft delete product",
          "request": {
            "method": "DELETE",
